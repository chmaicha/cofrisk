{
  "family": "cofrisk-task",
  "executionRoleArn": "arn:aws:iam::606636979223:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "cofrisk-api",
      "image": "606636979223.dkr.ecr.eu-west-3.amazonaws.com/cofrisk:v1",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "command": [
        "uvicorn",
        "src.cofrisk.api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cofrisk",
          "awslogs-region": "eu-west-3",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "3072"
}